+/* MSA client id the refresh token was issued to. Defaults to Minecraft
+ * Bedrock's; other titles (e.g. Minecraft Dungeons II, 00000000497C1B94)
+ * set HKLM\Software\Wine\WineGDK "MsaAppId" to their MicrosoftGame.Config
+ * MSAAppId so OAuth refresh and SISU are bound to the right title. */
+static LPCSTR GetMsaAppId( void )
+{
+    static char app_id[64];
+    static LONG loaded;
+    DWORD size = sizeof(app_id);
+
+    if (!InterlockedCompareExchange( &loaded, 1, 0 ))
+    {
+        if (ERROR_SUCCESS != RegGetValueA( HKEY_LOCAL_MACHINE, "Software\\Wine\\WineGDK", "MsaAppId",
+                                           RRF_RT_REG_SZ, NULL, app_id, &size ) || !app_id[0])
+            lstrcpynA( app_id, "0000000048183522", sizeof(app_id) );
+        TRACE( "using MSA app id %s\n", app_id );
+        InterlockedExchange( &loaded, 2 );
+    }
+    while (InterlockedCompareExchange( &loaded, 2, 2 ) != 2) YieldProcessor();
+    return app_id;
+}
